{
  "name": "worker",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:apply:local": "npm run db:apply:auth:local && npm run db:apply:apps:local",
    "db:apply:remote": "npm run db:apply:auth:remote && npm run db:apply:apps:remote",
    "db:apply:auth:local": "wrangler d1 execute users_tracker_auth --local --file=./schema-auth.sql",
    "db:apply:auth:remote": "wrangler d1 execute users_tracker_auth --remote --file=./schema-auth.sql",
    "db:apply:apps:local": "wrangler d1 execute users_tracker_apps --local --file=./schema-apps.sql",
    "db:apply:apps:remote": "wrangler d1 execute users_tracker_apps --remote --file=./schema-apps.sql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
